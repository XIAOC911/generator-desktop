{
  "name": "dianshang-mowan",
  "version": "4.9.0",
  "private": true,
  "license": "MIT",
  "description": "Electron + React + TypeScript desktop app for ecommerce hero image generation.",
  "author": "京",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:web && npm run build:electron",
    "watch:web": "vite build --watch",
    "watch:electron": "tsc -p tsconfig.electron.json --watch",
    "watch": "concurrently -k \"npm run watch:web\" \"npm run watch:electron\"",
    "preview": "vite preview",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:dir": "npm run build && electron-builder --dir",
    "release:win": "npm run dist:win"
  },
  "build": {
    "appId": "com.dianshang.mowan.desktop",
    "productName": "电商魔丸",
    "copyright": "Copyright © 京",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build-resources/icon.png",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico",
      "artifactName": "电商魔丸-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "ag-psd": "^30.1.0",
    "cacheable-request": "^7.0.4",
    "canvas": "^3.2.3",
    "esbuild": "^0.28.0",
    "escalade": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "source-map-js": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}
